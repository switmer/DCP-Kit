# Cloud Agent Environment — DCP-Transformer
# Copy to .env.local before running scripts/agent/bootstrap

AGENT_MODE=true

# --- Dev-safe (included directly) ---

# JWT secret for local API server (dev default, not a real secret)
DCP_JWT_SECRET=dev-secret-agent-mode

# MCP server flags
MCP_STDIO=false
DCP_MCP_SERVER=false

# CSS eval (disabled by default for safety)
DCP_UNSAFE_CSS_EVAL=0

# Test verbosity
JEST_VERBOSE=false

# --- Mock-safe (optional, for features that call external services) ---

# Registry token — leave empty unless testing registry auth
DCP_REGISTRY_TOKEN=

# --- Dashboard-only (set in cloud agent secret manager if needed) ---
# These are NEVER included with real values here.
# Only needed for specific optional commands (publish, LLM enrichment).

# OPENAI_API_KEY=        # Only for: dcp extract --enrich
# AWS_ACCESS_KEY_ID=     # Only for: dcp registry publish --target s3
# AWS_SECRET_ACCESS_KEY= # Only for: dcp registry publish --target s3
# GITHUB_TOKEN=          # Only for: dcp registry publish --target github-pages
